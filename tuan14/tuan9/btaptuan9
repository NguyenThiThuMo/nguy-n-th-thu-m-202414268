#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Ngay {
    int ngay, thang, nam;
};

struct SinhVien {
    char maSV[8];
    char hoTen[50];
    int gioiTinh; // 1: Nam, 0: Nu
    struct Ngay ngaySinh;
    char diaChi[100];
    char lop[12];
    char khoa[7];
};

struct Node {
    struct SinhVien data;
    struct Node* next;
};

struct List {
    struct Node* head;
};

void init(struct List* L) {
    L->head = NULL;
}

void xoaXuongDong(char* s) {
    s[strcspn(s, "\n")] = '\0';
}

int cungNgay(struct Ngay a, struct Ngay b) {
    return (a.ngay == b.ngay && a.thang == b.thang && a.nam == b.nam);
}

struct SinhVien nhapSV() {
    struct SinhVien sv;

    while (getchar() != '\n'); 

    printf("Ma SV: ");
    fgets(sv.maSV, sizeof(sv.maSV), stdin);
    xoaXuongDong(sv.maSV);

    printf("Ho ten: ");
    fgets(sv.hoTen, sizeof(sv.hoTen), stdin);
    xoaXuongDong(sv.hoTen);

    printf("Gioi tinh (1-Nam, 0-Nu): ");
    scanf("%d", &sv.gioiTinh);

    printf("Ngay sinh (ngay thang nam): ");
    scanf("%d %d %d", &sv.ngaySinh.ngay, &sv.ngaySinh.thang, &sv.ngaySinh.nam);

    while (getchar() != '\n'); 

    printf("Dia chi: ");
    fgets(sv.diaChi, sizeof(sv.diaChi), stdin);
    xoaXuongDong(sv.diaChi);

    printf("Lop: ");
    fgets(sv.lop, sizeof(sv.lop), stdin);
    xoaXuongDong(sv.lop);

    printf("Khoa: ");
    fgets(sv.khoa, sizeof(sv.khoa), stdin);
    xoaXuongDong(sv.khoa);

    return sv;
}

void insertSorted(struct List* L, struct SinhVien sv) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));

    if (newNode == NULL) {
        printf("Loi cap phat bo nho!\n");
        return;
    }

    newNode->data = sv;
    newNode->next = NULL;

    if (L->head == NULL || strcmp(sv.maSV, L->head->data.maSV) < 0) {
        newNode->next = L->head;
        L->head = newNode;
        return;
    }

    struct Node* p = L->head;
    while (p->next != NULL && strcmp(p->next->data.maSV, sv.maSV) < 0) {
        p = p->next;
    }

    newNode->next = p->next;
    p->next = newNode;
}

void inDS(struct List L) {
    if (L.head == NULL) {
        printf("(Danh sach rong)\n");
        return;
    }
    struct Node* p = L.head;
    while (p != NULL) {
        printf("[%s] %s\n", p->data.maSV, p->data.hoTen);
        p = p->next;
    }
}

void inTrungNgay(struct List L) {
    struct Node* p = L.head;
    int found = 0;

    while (p != NULL) {
        struct Node* q = p->next;
        while (q != NULL) {
            if (cungNgay(p->data.ngaySinh, q->data.ngaySinh)) {
                printf("%s va %s trung ngay sinh\n",
                    p->data.hoTen, q->data.hoTen);
                found = 1;
            }
            q = q->next;
        }
        p = p->next;
    }

    if (!found)
        printf("Khong tim thay sinh vien cung ngay sinh\n");
}

void xoaTrungNgay(struct List* L) {
    struct Node* p = L->head;

    while (p != NULL) {
      
        int trung = 0;
        struct Node* q = L->head;
        while (q != NULL) {
            if (q != p && cungNgay(p->data.ngaySinh, q->data.ngaySinh)) {
                trung = 1;
                break;
            }
            q = q->next;
        }

        if (trung) {
         
            if (p == L->head) {
                L->head = p->next;
                free(p);
                p = L->head;
            } else {
               
                struct Node* prev = L->head;
                while (prev->next != p) prev = prev->next;
                prev->next = p->next;
                free(p);
                p = prev->next;
            }
        } else {
            p = p->next;
        }
    }
}

int main() {
    struct List ds;
    init(&ds);

    int n;
    printf("Nhap so SV: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("\nNhap SV thu %d:\n", i + 1);
        struct SinhVien sv = nhapSV();
        insertSorted(&ds, sv);
    }

    printf("Danh sach\n");
    inDS(ds);

    printf("SV trung ngay sinh \n");
    inTrungNgay(ds);

    printf("Sau khi xoa\n");
    xoaTrungNgay(&ds);
    inDS(ds);

    return 0;
}

