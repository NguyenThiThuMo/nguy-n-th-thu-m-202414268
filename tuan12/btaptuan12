#include <stdio.h>

void inmang(int a[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");
}

void vundong(int a[], int n, int i) {
    int max = i;          
    int trai = 2 * i + 1; 
    int phai = 2 * i + 2; 
    if (trai < n && a[trai] > a[max]) {
        max = trai;
    }

    
    if (phai < n && a[phai] > a[max]) {
        max = phai;
    }

    
    if (max != i) {
        int temp = a[i];
        a[i] = a[max];
        a[max] = temp;

        vundong(a, n, max);
    }
}


