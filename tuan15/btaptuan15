#include <iostream>
#include <queue>
using namespace std;

const int N = 11;
string tenTP[N] = {
    "Ha Noi", "Thai Nguyen", "Bac Ninh", "Bac Giang", "Uong Bi",
    "Hai Phong", "Hai Duong", "Hung Yen", "Phu Ly", "Hoa Binh", "Son Tay"
};
// cau truc node
struct Node {
    int dest;
    Node* next;
};
Node* head[N] = {nullptr};
Node* tail[N] = {nullptr};
// chen mot dinh vao cuoi dslk dinh khac
void chenVaoCuoi(int u, int v) {
    Node* newNode = new Node;
    newNode->dest = v;
    newNode->next = nullptr;

    if (head[u] == nullptr) {
        head[u] = newNode;
        tail[u] = newNode;
    } else {
        tail[u]->next = newNode;
        tail[u] = newNode;
    }
}
void themCanh(int u, int v) {
    chenVaoCuoi(u, v);
    chenVaoCuoi(v, u);
}
// duyet theo chieu rong bfs 
void BFS(int start) {
    bool visited[N] = {false};
    queue<int> q;

    visited[start] = true;
    q.push(start);

    while(!q.empty()) {
        int u = q.front();
        q.pop();

        cout << tenTP[u] << " -> ";
        Node* neighbor = head[u];
        while (neighbor != nullptr) {
            int v = neighbor->dest;
            if (!visited[v]) {
                visited[v] = true;
                q.push(v);
            }
            neighbor = neighbor->next;
        }
    }
    cout << "END\n";
}
int main() {
    themCanh(0, 1);  // Hà Nội - Thái Nguyên (D7)
    themCanh(0, 2);  // Hà Nội - Bắc Ninh (D8)
    themCanh(0, 6);  // Hà Nội - Hải Dương (D1)
    themCanh(0, 8);  // Hà Nội - Phủ Lý (D4)
    themCanh(0, 9);  // Hà Nội - Hòa Bình (D5)
    themCanh(0, 10); // Hà Nội - Sơn Tây (D6)
    themCanh(2, 3);  // Bắc Ninh - Bắc Giang (D9)
    themCanh(2, 4);  // Bắc Ninh - Uông Bí (D11)
    themCanh(3, 4);  // Bắc Giang - Uông Bí (D10)
    themCanh(4, 5);  // Uông Bí - Hải Phòng (D12)
    themCanh(5, 6);  // Hải Phòng - Hải Dương (D13)
    themCanh(6, 7);  // Hải Dương - Hưng Yên (D2)
    themCanh(7, 8);  // Hưng Yên - Phủ Lý (D3)
    cout << "Ket qua cua duyet BFS tu Ha Noi:\n";
    BFS(0);
    return 0;
}